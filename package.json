{
  "name": "@oka/openhands-openspec-board",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run workflow:check && node scripts/build.mjs",
    "workflow:extract": "node scripts/extract-role-workflow.mjs",
    "workflow:check": "node scripts/check-workflow-viewer.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "validate": "node scripts/validate.mjs",
    "canvas:navigation": "node scripts/apply-canvas-navigation.mjs",
    "spec:validate": "openspec validate --all --strict",
    "check": "npm run build && npm test && npm run validate && npm run spec:validate"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.0",
    "entities": "8.1.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "marked": "18.0.14"
  }
}
